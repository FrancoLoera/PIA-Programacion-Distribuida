@page
@model PIA_Gimnasio.Pages.Salones.IndexModel
@{
    ViewData["Title"] = "Gestión de Salones";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-door-open me-2"></i>Salones de Entrenamiento
        </h3>
        <p class="text-muted small mb-0">Administración de espacios físicos para clases y entrenamientos por sucursal.</p>
    </div>
    <div class="col-md-5 text-md-end mt-2 mt-md-0">
        <a asp-page="/Sucursales/Index" class="btn btn-outline-dark btn-sm me-1">
            <i class="bi bi-building me-1"></i>Ver Sucursales
        </a>
        <a asp-page="/Index" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Inicio
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    var alertClass = Model.TipoMensaje == "success" ? "alert-dark" : "alert-warning";
    var iconClass = Model.TipoMensaje == "success" ? "bi-check-circle" : "bi-exclamation-triangle";
    <div class="alert @alertClass alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi @iconClass me-2"></i>@Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="row g-4">
    <!-- Formulario Crear/Editar -->
    <div class="col-lg-4">
        <div class="card bg-white shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h6 class="card-title mb-0 fw-semibold">
                    <i class="bi @(Model.Salon.IdSalon > 0 ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                    @(Model.Salon.IdSalon > 0 ? "Modificar Salón" : "Nuevo Salón")
                </h6>
            </div>
            <div class="card-body p-3">
                <form method="post" asp-page-handler="Guardar">
                    <input type="hidden" asp-for="Salon.IdSalon" />

                    <div class="mb-3">
                        <label asp-for="Salon.IdSucursal" class="form-label small fw-semibold">Sucursal *</label>
                        <select asp-for="Salon.IdSucursal" class="form-select form-select-sm" required>
                            <option value="">-- Selecciona una sucursal --</option>
                            @if (Model.Sucursales != null)
                            {
                                foreach (System.Data.DataRow suc in Model.Sucursales.Rows)
                                {
                                    <option value="@suc["IdSucursal"]">@suc["Nombre"] (@suc["Ciudad"])</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Salon.IdSucursal" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Salon.NombreNumero" class="form-label small fw-semibold">Identificador / Nombre del Salón *</label>
                        <input asp-for="Salon.NombreNumero" class="form-control form-control-sm" placeholder="Ej. Salón Spinning A, Sala 2" required maxlength="50" />
                        <span asp-validation-for="Salon.NombreNumero" class="text-danger small"></span>
                    </div>

                    @if (Model.Salon.IdSalon > 0)
                    {
                        <div class="mb-3">
                            <label asp-for="Salon.IdEstatus" class="form-label small fw-semibold">Estatus</label>
                            <select asp-for="Salon.IdEstatus" class="form-select form-select-sm">
                                <option value="1">Disponible</option>
                                <option value="2">Mantenimiento</option>
                                <option value="3">Inactivo</option>
                            </select>
                        </div>
                    }

                    <div class="d-flex justify-content-between pt-2">
                        @if (Model.Salon.IdSalon > 0)
                        {
                            <a asp-page="/Salones/Index" asp-route-idSucursal="@Model.IdSucursal" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-x me-1"></i>Cancelar
                            </a>
                        }
                        <button type="submit" class="btn btn-dark btn-sm ms-auto">
                            <i class="bi bi-save me-1"></i>@(Model.Salon.IdSalon > 0 ? "Actualizar" : "Registrar")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Listado de Salones -->
    <div class="col-lg-8">
        <div class="card bg-white shadow-sm border-0 mb-3">
            <div class="card-body p-3">
                <form method="get" class="row g-2">
                    <div class="col-md-5">
                        <select asp-for="IdSucursal" class="form-select form-select-sm">
                            <option value="">Todas las sucursales</option>
                            @if (Model.Sucursales != null)
                            {
                                foreach (System.Data.DataRow suc in Model.Sucursales.Rows)
                                {
                                    <option value="@suc["IdSucursal"]">@suc["Nombre"]</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" asp-for="Buscar" class="form-control" placeholder="Buscar por nombre..." />
                        </div>
                    </div>
                    <div class="col-md-3 d-flex gap-1">
                        <button type="submit" class="btn btn-dark btn-sm w-100">
                            <i class="bi bi-funnel me-1"></i>Filtrar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card bg-white shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width: 60px;">ID</th>
                            <th>Salón</th>
                            <th>Sucursal</th>
                            <th>Estatus</th>
                            <th class="text-end pe-3" style="width: 140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Salones == null || Model.Salones.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                                    No se encontraron salones registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (System.Data.DataRow r in Model.Salones.Rows)
                            {
                                var id = Convert.ToInt32(r["IdSalon"]);
                                var estatus = r["Estatus"]?.ToString() ?? "";
                                var badgeClass = estatus switch
                                {
                                    "Disponible" => "bg-dark text-white",
                                    "Mantenimiento" => "bg-secondary text-white",
                                    _ => "bg-light text-dark border"
                                };

                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@id</td>
                                    <td class="fw-semibold text-dark">@r["NombreNumero"]</td>
                                    <td>
                                        <i class="bi bi-building me-1 text-muted"></i>@r["Sucursal"]
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass">@estatus</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-page="/Salones/Index" asp-page-handler="Editar" asp-route-id="@id" class="btn btn-outline-dark" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (estatus != "Inactivo")
                                            {
                                                <form method="post" asp-page-handler="Baja" asp-route-id="@id" class="d-inline" onsubmit="return confirm('¿Confirmas dar de baja este salón?');">
                                                    <button type="submit" class="btn btn-outline-danger" title="Dar de baja">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
