@page
@model PIA_Gimnasio.Pages.Membresias.PlanesModel
@{
    ViewData["Title"] = "Tipos de Membresía";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-card-list me-2"></i>Tipos de Membresía</h3>
        <p class="text-muted small mb-0">Catálogo de membresías: cuotas, acceso a clases y aforo.</p>
    </div>
    <div class="col-md-5 text-md-end mt-2 mt-md-0">
        <a asp-page="/Membresias/Index" class="btn btn-outline-secondary btn-sm me-1">
            <i class="bi bi-person-check me-1"></i>Suscripciones
        </a>
        <a asp-page="/Index" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Inicio
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    var alertClass = Model.TipoMensaje == "success" ? "alert-dark" : "alert-warning";
    var iconClass = Model.TipoMensaje == "success" ? "bi-check-circle" : "bi-exclamation-triangle";
    <div class="alert @alertClass alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi @iconClass me-2"></i>@Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="row g-4">
    <!-- Formulario Crear / Editar Membresía -->
    <div class="col-lg-4">
        <div class="card bg-white shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h6 class="card-title mb-0 fw-semibold">
                    <i class="bi @(Model.Plan.IdMembresia > 0 ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                    @(Model.Plan.IdMembresia > 0 ? "Modificar Membresía" : "Nueva Membresía")
                </h6>
            </div>
            <div class="card-body p-3">
                <form method="post" asp-page-handler="Guardar">
                    <input type="hidden" asp-for="Plan.IdMembresia" />

                    <div class="mb-3">
                        <label asp-for="Plan.Nombre" class="form-label small fw-semibold">Nombre *</label>
                        <input asp-for="Plan.Nombre" class="form-control form-control-sm" placeholder="Ej. Bronce, Plata, Oro..." required maxlength="30" />
                        <span asp-validation-for="Plan.Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Plan.Precio" class="form-label small fw-semibold">Precio ($ Mensual) *</label>
                        <input asp-for="Plan.Precio" type="number" step="0.01" class="form-control form-control-sm" min="0" required />
                        <span asp-validation-for="Plan.Precio" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Plan.Descripcion" class="form-label small fw-semibold">Descripción *</label>
                        <textarea asp-for="Plan.Descripcion" class="form-control form-control-sm" rows="3" placeholder="Detalles de cobertura y beneficios..." required maxlength="300"></textarea>
                        <span asp-validation-for="Plan.Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="card bg-light border-0 p-3 mb-3">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="Plan.PermiteClases" class="form-check-input" type="checkbox" id="chkPermiteClases" onchange="toggleClases(this)" />
                            <label class="form-check-label small fw-semibold" for="chkPermiteClases">Permite agendar clases</label>
                        </div>

                        <div class="mb-2" id="divMaxClases" style="display: @(Model.Plan.PermiteClases ? "block" : "none");">
                            <label asp-for="Plan.MaxClasesSemana" class="form-label small fw-semibold">Máx. Clases / Semana</label>
                            <input asp-for="Plan.MaxClasesSemana" type="number" class="form-control form-control-sm" min="0" max="50" />
                            <span asp-validation-for="Plan.MaxClasesSemana" class="text-danger small"></span>
                        </div>

                        <div class="form-check form-switch">
                            <input asp-for="Plan.SujetaAforo" class="form-check-input" type="checkbox" id="chkSujetaAforo" />
                            <label class="form-check-label small fw-semibold" for="chkSujetaAforo">Sujeta a aforo de sucursal</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        @if (Model.Plan.IdMembresia > 0)
                        {
                            <a asp-page="/Membresias/Planes" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-x me-1"></i>Cancelar
                            </a>
                        }
                        <button type="submit" class="btn btn-dark btn-sm ms-auto">
                            <i class="bi bi-save me-1"></i>@(Model.Plan.IdMembresia > 0 ? "Actualizar" : "Registrar")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Listado de Membresías -->
    <div class="col-lg-8">
        <div class="card bg-white shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width:50px;">ID</th>
                            <th>Membresía</th>
                            <th style="width:110px;">Precio</th>
                            <th>Beneficios Clases</th>
                            <th style="width:100px;">Aforo</th>
                            <th class="text-end pe-3" style="width:90px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Planes == null || Model.Planes.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                                    No hay tipos de membresía registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (System.Data.DataRow r in Model.Planes.Rows)
                            {
                                var planId = Convert.ToByte(r["IdMembresia"]);
                                var precio = Convert.ToDecimal(r["Precio"]);
                                var nombre = r["Nombre"]?.ToString() ?? "";
                                var desc = r["Descripcion"]?.ToString() ?? "";
                                var permiteClases = Convert.ToBoolean(r["PermiteClases"]);
                                var maxClases = Convert.ToByte(r["MaxClasesSemana"]);
                                var sujetaAforo = Convert.ToBoolean(r["SujetaAforo"]);

                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@planId</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@nombre</div>
                                        <small class="text-muted">@desc</small>
                                    </td>
                                    <td><strong>$@precio.ToString("N2")</strong></td>
                                    <td>
                                        @if (permiteClases)
                                        {
                                            <span class="badge bg-dark text-white">
                                                <i class="bi bi-check me-1"></i>@maxClases clases/sem
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Sin clases</span>
                                        }
                                    </td>
                                    <td>
                                        @if (sujetaAforo)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-people me-1"></i>Sujeta</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white">Libre</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-page="/Membresias/Planes" asp-page-handler="Editar" asp-route-id="@planId"
                                           class="btn btn-outline-dark btn-sm" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleClases(chk) {
        var div = document.getElementById('divMaxClases');
        div.style.display = chk.checked ? 'block' : 'none';
        if (!chk.checked) {
            document.querySelector('[name="Plan.MaxClasesSemana"]').value = 0;
        }
    }
</script>
}
