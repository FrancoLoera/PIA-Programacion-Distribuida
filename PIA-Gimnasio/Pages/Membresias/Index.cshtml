@page
@model PIA_Gimnasio.Pages.Membresias.IndexModel
@{
    ViewData["Title"] = "Gestión de Membresías";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-person-check me-2"></i>Membresías de Socios</h3>
        <p class="text-muted small mb-0">Asignación, vigencia y control de suscripciones de clientes.</p>
    </div>
    <div class="col-md-5 text-md-end mt-2 mt-md-0">
        @if (User.IsInRole("Administrador"))
        {
            <a asp-page="/Membresias/Planes" class="btn btn-outline-secondary btn-sm me-1">
                <i class="bi bi-card-list me-1"></i>Tipos de Membresía
            </a>
        }
        <a asp-page="/Index" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Inicio
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    var alertClass = Model.TipoMensaje == "success" ? "alert-dark" : "alert-warning";
    var iconClass = Model.TipoMensaje == "success" ? "bi-check-circle" : "bi-exclamation-triangle";
    <div class="alert @alertClass alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi @iconClass me-2"></i>@Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="row g-4">
    <!-- Formulario Asignar / Renovar -->
    <div class="col-lg-4">
        <div class="card bg-white shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h6 class="card-title mb-0 fw-semibold">
                    <i class="bi @(Model.Suscripcion.IdSuscripcion > 0 ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                    @(Model.Suscripcion.IdSuscripcion > 0 ? "Modificar Suscripción" : "Contratar Membresía")
                </h6>
            </div>
            <div class="card-body p-3">
                <form method="post" asp-page-handler="Guardar">
                    <input type="hidden" asp-for="Suscripcion.IdSuscripcion" />

                    <div class="mb-3">
                        <label asp-for="Suscripcion.IdCliente" class="form-label small fw-semibold">Socio *</label>
                        <select asp-for="Suscripcion.IdCliente" class="form-select form-select-sm" required>
                            <option value="">-- Selecciona socio --</option>
                            @if (Model.Clientes != null)
                            {
                                foreach (System.Data.DataRow c in Model.Clientes.Rows)
                                {
                                    var idC = c["IdCliente"]?.ToString();
                                    var folio = c["Folio"]?.ToString();
                                    var nombreC = $"{folio} - {c["PrimerApellido"]} {c["Nombres"]}";
                                    <option value="@idC">@nombreC</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Suscripcion.IdCliente" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Suscripcion.IdMembresia" class="form-label small fw-semibold">Tipo de Membresía *</label>
                        <select asp-for="Suscripcion.IdMembresia" class="form-select form-select-sm" required>
                            <option value="">-- Selecciona membresía --</option>
                            @if (Model.Planes != null)
                            {
                                foreach (System.Data.DataRow p in Model.Planes.Rows)
                                {
                                    var idP = p["IdMembresia"]?.ToString();
                                    var nombreP = p["Nombre"]?.ToString();
                                    var precioP = Convert.ToDecimal(p["Precio"]).ToString("N2");
                                    var texto = $"{nombreP} (${precioP}/mes)";
                                    <option value="@idP">@texto</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Suscripcion.IdMembresia" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Suscripcion.FechaInicio" class="form-label small fw-semibold">Fecha de Inicio *</label>
                        <input asp-for="Suscripcion.FechaInicio" type="date" class="form-control form-control-sm" required />
                        <div class="form-text small text-muted">La vigencia es de 1 mes natural calculado por el sistema.</div>
                        <span asp-validation-for="Suscripcion.FechaInicio" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Suscripcion.IdEstatus" class="form-label small fw-semibold">Estatus</label>
                        <select asp-for="Suscripcion.IdEstatus" class="form-select form-select-sm">
                            <option value="2">Activa</option>
                            <option value="1">Pendiente</option>
                            <option value="3">Vencida</option>
                            <option value="4">Cancelada</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        @if (Model.Suscripcion.IdSuscripcion > 0)
                        {
                            <a asp-page="/Membresias/Index" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-x me-1"></i>Cancelar
                            </a>
                        }
                        <button type="submit" class="btn btn-dark btn-sm ms-auto">
                            <i class="bi bi-save me-1"></i>@(Model.Suscripcion.IdSuscripcion > 0 ? "Actualizar" : "Registrar")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Listado de Suscripciones -->
    <div class="col-lg-8">
        <!-- Filtros -->
        <div class="card bg-white shadow-sm border-0 mb-3">
            <div class="card-body p-3">
                <form method="get" class="row g-2">
                    <div class="col-md-5">
                        <select asp-for="FiltroPlan" class="form-select form-select-sm">
                            <option value="">Todas las membresías</option>
                            @if (Model.Planes != null)
                            {
                                foreach (System.Data.DataRow p in Model.Planes.Rows)
                                {
                                    var idPl = p["IdMembresia"]?.ToString();
                                    var nPl = p["Nombre"]?.ToString();
                                    <option value="@idPl">@nPl</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select asp-for="FiltroEstatus" class="form-select form-select-sm">
                            <option value="">Todos los estatus</option>
                            <option value="2">Activa</option>
                            <option value="1">Pendiente</option>
                            <option value="3">Vencida</option>
                            <option value="4">Cancelada</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-dark btn-sm w-100">
                            <i class="bi bi-funnel me-1"></i>Filtrar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card bg-white shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width:50px;">ID</th>
                            <th>Socio</th>
                            <th>Membresía</th>
                            <th>Vigencia</th>
                            <th style="width:100px;">Estado</th>
                            <th class="text-end pe-3" style="width:120px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Suscripciones == null || Model.Suscripciones.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                                    No se encontraron membresías registradas.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (System.Data.DataRow row in Model.Suscripciones.Rows)
                            {
                                var idSus = Convert.ToInt32(row["IdSuscripcion"]);
                                var folioSocio = row["Folio"]?.ToString() ?? "";
                                var nombreSocio = $"{row["PrimerApellido"]} {row["Nombres"]}";
                                var planNombre = row["Membresia"]?.ToString() ?? "";
                                var precio = Convert.ToDecimal(row["Precio"]);
                                var fechaIni = Convert.ToDateTime(row["FechaInicio"]).ToString("dd/MM/yyyy");
                                var fechaVen = Convert.ToDateTime(row["FechaVencimiento"]).ToString("dd/MM/yyyy");
                                var estadoVigencia = row["EstadoVigencia"]?.ToString() ?? row["Estatus"]?.ToString() ?? "";
                                var esVigente = estadoVigencia.Equals("Vigente", StringComparison.OrdinalIgnoreCase) || estadoVigencia.Equals("Activa", StringComparison.OrdinalIgnoreCase);

                                string badgeClass = estadoVigencia switch
                                {
                                    "Vigente" or "Activa" => "bg-dark text-white",
                                    "Vencida" => "bg-warning text-dark",
                                    "Cancelada" => "bg-secondary text-white",
                                    _ => "bg-light text-dark border"
                                };

                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@idSus</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@nombreSocio</div>
                                        <small class="text-muted"><i class="bi bi-tag me-1"></i>@folioSocio</small>
                                    </td>
                                    <td>
                                        <div><strong>@planNombre</strong></div>
                                        <small class="text-muted">$@precio.ToString("N2")/mes</small>
                                    </td>
                                    <td>
                                        <small><i class="bi bi-calendar-check text-muted me-1"></i>@fechaIni</small>
                                        <br />
                                        <small class="text-muted"><i class="bi bi-calendar-x me-1"></i>@fechaVen</small>
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass">@estadoVigencia</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-page="/Membresias/Index" asp-page-handler="Editar" asp-route-id="@idSus"
                                               class="btn btn-outline-dark" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (esVigente)
                                            {
                                                <form method="post" asp-page-handler="Cancelar" asp-route-id="@idSus"
                                                      class="d-inline" onsubmit="return confirm('¿Cancelar esta suscripción?');">
                                                    <button type="submit" class="btn btn-outline-danger" title="Cancelar">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
