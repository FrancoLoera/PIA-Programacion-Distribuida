<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Gimnasios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold text-white" asp-page="/Index"><img src="~/images/Mamadriguera White.png" width="100" alt="Mamadriguera" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContenido"
                        aria-controls="navbarContenido" aria-expanded="false" aria-label="Navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContenido">
                    @{
                        var esAdmin = User.IsInRole("Administrador");
                        var esRecepcion = User.IsInRole("Recepcionista");
                        var esEntrenador = User.IsInRole("Entrenador");
                    }
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-page="/Index">Inicio</a>
                        </li>
                        @if (esAdmin || esRecepcion || esEntrenador)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white-50" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Socios</a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow">
                                    @if (esAdmin || esRecepcion)
                                    {
                                        <li><a class="dropdown-item" asp-page="/Clientes/Index"><i class="bi bi-people me-2"></i>Socios</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-page="/Expedientes/Index"><i class="bi bi-file-medical me-2"></i>Expedientes médicos</a></li>
                                    @if (esAdmin || esRecepcion)
                                    {
                                        <li><a class="dropdown-item" asp-page="/Membresias/Index"><i class="bi bi-person-check me-2"></i>Membresías</a></li>
                                    }
                                    @if (esAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-page="/Membresias/Planes"><i class="bi bi-card-list me-2"></i>Tipos de membresía</a></li>
                                    }
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white-50" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Operación</a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow">
                                    @if (esAdmin || esRecepcion)
                                    {
                                        <li><a class="dropdown-item" asp-page="/ControlAcceso/Index"><i class="bi bi-door-open me-2"></i>Control de acceso</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-page="/Clases/Index"><i class="bi bi-calendar3 me-2"></i>Clases</a></li>
                                    <li><a class="dropdown-item" asp-page="/Reservas/Index"><i class="bi bi-card-checklist me-2"></i>Reservas y asistencia</a></li>
                                    @if (esAdmin || esEntrenador)
                                    {
                                        <li><a class="dropdown-item" asp-page="/Rutinas/Index"><i class="bi bi-person-walking me-2"></i>Rutinas</a></li>
                                        <li><a class="dropdown-item" asp-page="/Ejercicios/Index"><i class="bi bi-activity me-2"></i>Catálogo de ejercicios</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (esAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white-50" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow">
                                    <li><a class="dropdown-item" asp-page="/Empleados/Index"><i class="bi bi-person-badge me-2"></i>Empleados</a></li>
                                    <li><a class="dropdown-item" asp-page="/Sucursales/Index"><i class="bi bi-building me-2"></i>Sucursales</a></li>
                                    <li><a class="dropdown-item" asp-page="/Salones/Index"><i class="bi bi-door-closed me-2"></i>Salones</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-page="/Usuarios/Index"><i class="bi bi-person-gear me-2"></i>Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-page="/Auditoria/Index"><i class="bi bi-journal-text me-2"></i>Auditoría</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Reportes/Index">Reportes</a>
                            </li>
                        }
                    </ul>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var nombreUsuario = User.FindFirst("NombreCompleto")?.Value ?? User.Identity.Name;
                        var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                        var sucursal = User.FindFirst("Sucursal")?.Value;

                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>@nombreUsuario
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                                    <li><span class="dropdown-item-text small text-white-50">@rol</span></li>
                                    @if (!string.IsNullOrEmpty(sucursal))
                                    {
                                        <li><span class="dropdown-item-text small text-white-50">@sucursal</span></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-page="/Logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top py-3 text-muted bg-white mt-5">
        <div class="container text-center small">
            &copy; 2026 - Mamadriguera xd. Todos los derechos reservados.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
