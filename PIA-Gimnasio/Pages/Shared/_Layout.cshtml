<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Gimnasios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold text-white" asp-page="/Index">Sistema de Gimnasios</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContenido"
                        aria-controls="navbarContenido" aria-expanded="false" aria-label="Navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContenido">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-page="/Index">Inicio</a>
                        </li>
                        @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Clientes/Index">Socios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Membresias/Index">Membresías</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/ControlAcceso/Index">Acceso</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista") || User.IsInRole("Entrenador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Clases/Index">Clases</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Reservas/Index">Reservas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Expedientes/Index">Expedientes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Rutinas/Index">Rutinas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Reportes/Index">Reportes</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Sucursales/Index">Sucursales</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Salones/Index">Salones</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Empleados/Index">Empleados</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Usuarios/Index">Usuarios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-page="/Auditoria/Index">Auditoría</a>
                            </li>
                        }
                    </ul>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var nombreUsuario = User.FindFirst("NombreCompleto")?.Value ?? User.Identity.Name;
                        var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                        var sucursal = User.FindFirst("Sucursal")?.Value;

                        <div class="d-flex align-items-center">
                            <span class="me-3 small text-white-50">
                                <span class="text-white">@nombreUsuario</span>
                                @if (!string.IsNullOrEmpty(rol))
                                {
                                    <span>(@rol)</span>
                                }
                                @if (!string.IsNullOrEmpty(sucursal))
                                {
                                    <span> - @sucursal</span>
                                }
                            </span>
                            <a asp-page="/Logout" class="btn btn-sm btn-outline-light">
                                <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top py-3 text-muted bg-white mt-5">
        <div class="container text-center small">
            &copy; 2026 - Sistema de Gestión de Gimnasios. Todos los derechos reservados.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
