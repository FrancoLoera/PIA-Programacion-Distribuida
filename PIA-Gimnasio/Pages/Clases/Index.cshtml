@page
@model PIA_Gimnasio.Pages.Clases.IndexModel
@{
    ViewData["Title"] = "Clases y Horarios";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-calendar3 me-2"></i>Clases y Horarios</h3>
        <p class="text-muted small mb-0">Programación de sesiones grupales, asignación de salones e instructores.</p>
    </div>
    <div class="col-md-5 text-md-end mt-2 mt-md-0">
        <a asp-page="/Index" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Inicio
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    var alertClass = Model.TipoMensaje == "success" ? "alert-dark" : "alert-warning";
    var iconClass = Model.TipoMensaje == "success" ? "bi-check-circle" : "bi-exclamation-triangle";
    <div class="alert @alertClass alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi @iconClass me-2"></i>@Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="row g-4">
    @if (Model.PuedeGestionar)
    {
        <!-- Formulario Programar / Editar Clase -->
        <div class="col-lg-4">
            <div class="card bg-white shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h6 class="card-title mb-0 fw-semibold">
                        <i class="bi @(Model.Clase.IdClase > 0 ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(Model.Clase.IdClase > 0 ? "Modificar Clase" : "Programar Nueva Clase")
                    </h6>
                </div>
                <div class="card-body p-3">
                    <form method="post" asp-page-handler="Guardar">
                        <input type="hidden" asp-for="Clase.IdClase" />

                        <div class="mb-3">
                            <label asp-for="Clase.Nombre" class="form-label small fw-semibold">Nombre de la clase *</label>
                            <input asp-for="Clase.Nombre" class="form-control form-control-sm" placeholder="Ej. Spinning Matutino, Yoga Flow..." required maxlength="80" />
                            <span asp-validation-for="Clase.Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Clase.Fecha" class="form-label small fw-semibold">Fecha *</label>
                            <input asp-for="Clase.Fecha" type="date" class="form-control form-control-sm" required />
                            <span asp-validation-for="Clase.Fecha" class="text-danger small"></span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Clase.HoraInicio" class="form-label small fw-semibold">Hora Inicio *</label>
                                <input asp-for="Clase.HoraInicio" type="time" class="form-control form-control-sm" required />
                                <span asp-validation-for="Clase.HoraInicio" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Clase.HoraFin" class="form-label small fw-semibold">Hora Fin *</label>
                                <input asp-for="Clase.HoraFin" type="time" class="form-control form-control-sm" required />
                                <span asp-validation-for="Clase.HoraFin" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Clase.IdSalon" class="form-label small fw-semibold">Salón *</label>
                                <select asp-for="Clase.IdSalon" class="form-select form-select-sm" required>
                                    <option value="">-- Selecciona --</option>
                                    @if (Model.Salones != null)
                                    {
                                        foreach (System.Data.DataRow s in Model.Salones.Rows)
                                        {
                                            var idSal = s["IdSalon"]?.ToString();
                                            var nomSal = s["NombreNumero"]?.ToString();
                                            var sucSal = s["Sucursal"]?.ToString();
                                            <option value="@idSal">@nomSal (@sucSal)</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Clase.IdSalon" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Clase.CupoMaximo" class="form-label small fw-semibold">Cupo Máx. *</label>
                                <input asp-for="Clase.CupoMaximo" type="number" class="form-control form-control-sm" min="1" max="500" required />
                                <span asp-validation-for="Clase.CupoMaximo" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Clase.IdEmpleado" class="form-label small fw-semibold">Instructor / Entrenador *</label>
                            <select asp-for="Clase.IdEmpleado" class="form-select form-select-sm" required>
                                <option value="">-- Selecciona instructor --</option>
                                @if (Model.Instructores != null)
                                {
                                    foreach (System.Data.DataRow emp in Model.Instructores.Rows)
                                    {
                                        var idEmp = emp["IdEmpleado"]?.ToString();
                                        var nomEmp = $"{emp["PrimerApellido"]} {emp["Nombres"]} ({emp["Puesto"]})";
                                        <option value="@idEmp">@nomEmp</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Clase.IdEmpleado" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Clase.IdEspecialidad" class="form-label small fw-semibold">Especialidad Requerida</label>
                            <select asp-for="Clase.IdEspecialidad" class="form-select form-select-sm">
                                <option value="">-- Ninguna (General) --</option>
                                @if (Model.Especialidades != null)
                                {
                                    foreach (System.Data.DataRow esp in Model.Especialidades.Rows)
                                    {
                                        var idEsp = esp["IdEspecialidad"]?.ToString();
                                        var nomEsp = esp["Nombre"]?.ToString();
                                        <option value="@idEsp">@nomEsp</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            @if (Model.Clase.IdClase > 0)
                            {
                                <a asp-page="/Clases/Index" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-x me-1"></i>Cancelar
                                </a>
                            }
                            <button type="submit" class="btn btn-dark btn-sm ms-auto">
                                <i class="bi bi-save me-1"></i>@(Model.Clase.IdClase > 0 ? "Actualizar" : "Programar Clase")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Listado / Cartelera de Clases -->
    <div class="@(Model.PuedeGestionar ? "col-lg-8" : "col-12")">
        <!-- Filtros de búsqueda -->
        <div class="card bg-white shadow-sm border-0 mb-3">
            <div class="card-body p-3">
                <form method="get" class="row g-2">
                    <div class="col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" asp-for="Buscar" class="form-control" placeholder="Buscar clase..." />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <input type="date" asp-for="FiltroFecha" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <select asp-for="FiltroSalon" class="form-select form-select-sm">
                            <option value="">Todos los salones</option>
                            @if (Model.Salones != null)
                            {
                                foreach (System.Data.DataRow sal in Model.Salones.Rows)
                                {
                                    var idS = sal["IdSalon"]?.ToString();
                                    var nomS = sal["NombreNumero"]?.ToString();
                                    <option value="@idS">@nomS</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select asp-for="FiltroEstatus" class="form-select form-select-sm">
                            <option value="">Todos los estatus</option>
                            <option value="1">Programada</option>
                            <option value="3">Finalizada</option>
                            <option value="2">Cancelada</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-dark btn-sm w-100">
                            <i class="bi bi-funnel me-1"></i>Filtrar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card bg-white shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width: 50px;">ID</th>
                            <th>Clase</th>
                            <th>Horario y Lugar</th>
                            <th>Instructor</th>
                            <th style="width: 100px;">Cupo</th>
                            <th style="width: 100px;">Estatus</th>
                            @if (Model.PuedeGestionar)
                            {
                                <th class="text-end pe-3" style="width: 110px;">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Clases == null || Model.Clases.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="@(Model.PuedeGestionar ? 7 : 6)" class="text-center text-muted py-4">
                                    <i class="bi bi-calendar-x d-block fs-3 mb-2"></i>
                                    No se encontraron clases programadas.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (System.Data.DataRow row in Model.Clases.Rows)
                            {
                                var idC = Convert.ToInt32(row["IdClase"]);
                                var nombre = row["Nombre"]?.ToString() ?? "";
                                var fechaStr = Convert.ToDateTime(row["Fecha"]).ToString("dd/MM/yyyy");
                                var iniTime = ((TimeSpan)row["HoraInicio"]).ToString(@"hh\:mm");
                                var finTime = ((TimeSpan)row["HoraFin"]).ToString(@"hh\:mm");
                                var salon = row["Salon"]?.ToString() ?? "";
                                var sucursal = row["Sucursal"]?.ToString() ?? "";
                                var instructor = row["Empleado"]?.ToString() ?? "";
                                var especialidad = row["EspecialidadRequerida"]?.ToString();
                                var cupo = Convert.ToInt32(row["CupoMaximo"]);
                                var ocupados = Convert.ToInt32(row["LugaresOcupados"]);
                                var estatus = row["Estatus"]?.ToString() ?? "";
                                var esProgramada = estatus.Equals("Programada", StringComparison.OrdinalIgnoreCase);

                                string badgeEstatus = estatus switch
                                {
                                    "Programada" => "bg-dark text-white",
                                    "Finalizada" => "bg-light text-muted border",
                                    "Cancelada" => "bg-secondary text-white",
                                    _ => "bg-secondary text-white"
                                };

                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@idC</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@nombre</div>
                                        @if (!string.IsNullOrEmpty(especialidad))
                                        {
                                            <span class="badge bg-light text-dark border small">@especialidad</span>
                                        }
                                    </td>
                                    <td>
                                        <div><i class="bi bi-clock me-1 text-muted"></i>@fechaStr (@iniTime - @finTime)</div>
                                        <small class="text-muted"><i class="bi bi-door-open me-1"></i>@salon &bull; @sucursal</small>
                                    </td>
                                    <td>
                                        <div><i class="bi bi-person me-1 text-muted"></i>@instructor</div>
                                    </td>
                                    <td>
                                        <span class="badge @(ocupados >= cupo ? "bg-warning text-dark" : "bg-dark text-white")">
                                            @ocupados / @cupo
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @badgeEstatus">@estatus</span>
                                    </td>
                                    @if (Model.PuedeGestionar)
                                    {
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                @if (esProgramada)
                                                {
                                                    <a asp-page="/Clases/Index" asp-page-handler="Editar" asp-route-id="@idC"
                                                       class="btn btn-outline-dark" title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <form method="post" asp-page-handler="Cancelar" asp-route-id="@idC"
                                                          class="d-inline" onsubmit="return confirm('¿Confirmas la cancelación de esta clase? Se liberarán las reservas.');">
                                                        <button type="submit" class="btn btn-outline-danger" title="Cancelar">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">&mdash;</span>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
