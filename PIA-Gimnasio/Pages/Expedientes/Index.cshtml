@page
@model PIA_Gimnasio.Pages.Expedientes.IndexModel
@{
    ViewData["Title"] = "Expedientes Médicos";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-file-medical me-2"></i>Expedientes Médicos</h3>
        <p class="text-muted small mb-0">Ficha médica de socios: registro de tipo de sangre y condiciones médicas asociadas.</p>
    </div>
    <div class="col-md-5 text-md-end mt-2 mt-md-0">
        @if (Model.PuedeEditar)
        {
            <button type="button" class="btn btn-dark btn-sm me-1" data-bs-toggle="modal" data-bs-target="#modalNuevoExpediente">
                <i class="bi bi-plus-circle me-1"></i>Nuevo Expediente
            </button>
            <button type="button" class="btn btn-outline-dark btn-sm" data-bs-toggle="modal" data-bs-target="#modalNuevaCondicion">
                <i class="bi bi-bookmark-plus me-1"></i>Catálogo Condiciones
            </button>
        }
        <a asp-page="/Index" class="btn btn-outline-secondary btn-sm ms-1">
            <i class="bi bi-arrow-left me-1"></i>Inicio
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    var alertClass = Model.TipoMensaje == "success" ? "alert-dark" : "alert-warning";
    var iconClass = Model.TipoMensaje == "success" ? "bi-check-circle" : "bi-exclamation-triangle";
    <div class="alert @alertClass alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi @iconClass me-2"></i>@Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Filtros de búsqueda -->
<div class="card bg-white shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6 col-lg-5">
                <label class="form-label small fw-semibold">Socio</label>
                <select name="FiltroCliente" class="form-select form-select-sm">
                    <option value="">-- Todos los socios --</option>
                    @if (Model.Socios != null)
                    {
                        foreach (System.Data.DataRow s in Model.Socios.Rows)
                        {
                            var id = Convert.ToInt32(s["IdCliente"]);
                            var sel = Model.FiltroCliente == id ? "selected" : null;
                            <option value="@id" selected="@sel">[@s["Folio"]] @s["Nombres"] @s["PrimerApellido"] @s["SegundoApellido"]</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4 col-lg-3">
                <label class="form-label small fw-semibold">Tipo de Sangre</label>
                <select name="FiltroTipoSangre" class="form-select form-select-sm">
                    <option value="">-- Todos --</option>
                    @{
                        string[] tipos = { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" };
                        foreach (var t in tipos)
                        {
                            var sel = Model.FiltroTipoSangre == t ? "selected" : null;
                            <option value="@t" selected="@sel">@t</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 col-lg-4 text-md-end">
                <button type="submit" class="btn btn-dark btn-sm me-1">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
                <a asp-page="/Expedientes/Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-circle me-1"></i>Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    <!-- Listado General de Expedientes -->
    <div class="@(Model.ExpedienteActual != null ? "col-lg-6" : "col-12")">
        <div class="card bg-white shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="card-title mb-0 fw-semibold">
                    <i class="bi bi-list-check me-2"></i>Listado de Expedientes Médicos (@Model.Expedientes.Count)
                </h6>
            </div>
            <div class="card-body p-0">
                @if (Model.Expedientes.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-folder2-open display-6 d-block mb-2 text-secondary"></i>
                        No se encontraron expedientes médicos registrados con los filtros aplicados.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Folio</th>
                                    <th>Socio</th>
                                    <th class="text-center">Tipo Sangre</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exp in Model.Expedientes)
                                {
                                    var estaSeleccionado = Model.ExpedienteActual?.IdExpediente == exp.IdExpediente;
                                    <tr class="@(estaSeleccionado ? "table-active" : "")">
                                        <td class="fw-semibold small">@exp.Folio</td>
                                        <td>
                                            <div class="fw-semibold text-dark">@exp.NombreCompleto</div>
                                            <span class="text-muted small">ID Socio: #@exp.IdCliente</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-dark text-white fs-6 px-2 py-1">@exp.TipoSangre</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-page="/Expedientes/Index"
                                               asp-route-ExpedienteDetalle="@exp.IdExpediente"
                                               asp-route-FiltroCliente="@Model.FiltroCliente"
                                               asp-route-FiltroTipoSangre="@Model.FiltroTipoSangre"
                                               class="btn btn-outline-dark btn-sm me-1"
                                               title="Ver ficha y condiciones">
                                                <i class="bi bi-eye me-1"></i>Ficha
                                            </a>
                                            @if (Model.PuedeEditar)
                                            {
                                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#modalEditarSangre"
                                                        data-id="@exp.IdExpediente"
                                                        data-socio="@exp.NombreCompleto"
                                                        data-sangre="@exp.TipoSangre"
                                                        onclick="prepararEdicionSangre(this)"
                                                        title="Actualizar tipo de sangre">
                                                    <i class="bi bi-droplet"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Panel de Detalle y Condiciones del Expediente Seleccionado -->
    @if (Model.ExpedienteActual != null)
    {
        <div class="col-lg-6">
            <div class="card bg-white shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="card-title mb-0 fw-semibold">
                        <i class="bi bi-heart-pulse me-2"></i>Ficha Médica: @Model.ExpedienteActual.NombreCompleto
                    </h6>
                    <a asp-page="/Expedientes/Index"
                       asp-route-FiltroCliente="@Model.FiltroCliente"
                       asp-route-FiltroTipoSangre="@Model.FiltroTipoSangre"
                       class="btn btn-outline-light btn-sm py-0 px-2">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2 mb-3 pb-3 border-bottom align-items-center">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Folio de Socio</span>
                            <span class="fw-bold">@Model.ExpedienteActual.Folio</span>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <span class="text-muted small d-block">Tipo de Sangre</span>
                            <span class="badge bg-dark text-white fs-6 px-3 py-1">@Model.ExpedienteActual.TipoSangre</span>
                        </div>
                    </div>

                    <!-- Condiciones Médicas del Socio -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-clipboard2-pulse me-1"></i>Condiciones Médicas (@Model.CondicionesActuales.Count)
                        </h6>
                    </div>

                    @if (Model.CondicionesActuales.Count == 0)
                    {
                        <div class="alert alert-secondary small text-center my-3" role="alert">
                            <i class="bi bi-info-circle me-1"></i>No hay condiciones o restricciones médicas asociadas a este socio.
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush mb-3 border rounded">
                            @foreach (var c in Model.CondicionesActuales)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-start p-3">
                                    <div class="me-auto">
                                        <div class="fw-bold text-dark">
                                            @c.Nombre
                                            <span class="badge bg-light text-dark border ms-1 small">@c.Tipo</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(c.Descripcion))
                                        {
                                            <div class="text-muted small">@c.Descripcion</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(c.Observaciones))
                                        {
                                            <div class="small mt-1 text-secondary">
                                                <i class="bi bi-chat-left-text me-1"></i><strong>Observaciones:</strong> @c.Observaciones
                                            </div>
                                        }
                                    </div>
                                    @if (Model.PuedeEditar)
                                    {
                                        <form method="post" asp-page-handler="DesvincularCondicion" class="ms-2">
                                            <input type="hidden" name="IdExpedienteDesvincular" value="@Model.ExpedienteActual.IdExpediente" />
                                            <input type="hidden" name="IdCondicionDesvincular" value="@c.IdCondicion" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2"
                                                    title="Desvincular condición médica"
                                                    onclick="return confirm('¿Seguro de desvincular esta condición del expediente?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (Model.PuedeEditar)
                    {
                        <!-- Formulario para asociar condición médica -->
                        <div class="bg-light p-3 rounded border">
                            <h6 class="fw-semibold text-dark small mb-2">
                                <i class="bi bi-plus-circle me-1"></i>Asociar Condición Médica al Socio
                            </h6>
                            <form method="post" asp-page-handler="AsociarCondicion">
                                <input type="hidden" asp-for="IdExpedienteCondicion" value="@Model.ExpedienteActual.IdExpediente" />
                                
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Condición del Catálogo *</label>
                                    <select asp-for="IdCondicionAsociar" class="form-select form-select-sm" required>
                                        <option value="">-- Selecciona condición --</option>
                                        @foreach (var cat in Model.CatalogoCondiciones)
                                        {
                                            <option value="@cat.IdCondicion">[@cat.Tipo] @cat.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Observaciones Específicas del Socio</label>
                                    <input asp-for="ObservacionesCondicion" class="form-control form-control-sm" placeholder="Ej. Rodilla izquierda intervenida en 2023" />
                                </div>
                                <button type="submit" class="btn btn-dark btn-sm w-100">
                                    <i class="bi bi-check2 me-1"></i>Guardar en Ficha Médica
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Crear Expediente -->
<div class="modal fade" id="modalNuevoExpediente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Crear">
                <div class="modal-header bg-dark text-white py-3">
                    <h6 class="modal-title fw-bold"><i class="bi bi-file-earmark-plus me-2"></i>Registrar Ficha Médica</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Crea la ficha médica con el tipo de sangre del socio. Posteriormente podrás asociar sus condiciones o alergias.</p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Socio *</label>
                        <select asp-for="IdClienteNuevo" class="form-select form-select-sm" required>
                            <option value="">-- Selecciona socio --</option>
                            @if (Model.Socios != null)
                            {
                                foreach (System.Data.DataRow s in Model.Socios.Rows)
                                {
                                    <option value="@s["IdCliente"]">[@s["Folio"]] @s["Nombres"] @s["PrimerApellido"] @s["SegundoApellido"]</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tipo de Sangre *</label>
                        <select asp-for="TipoSangreNuevo" class="form-select form-select-sm" required>
                            <option value="">-- Selecciona tipo de sangre --</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-check-lg me-1"></i>Crear Ficha</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Editar Tipo de Sangre -->
<div class="modal fade" id="modalEditarSangre" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post" asp-page-handler="ActualizarTipo">
                <div class="modal-header bg-dark text-white py-2">
                    <h6 class="modal-title fw-bold small"><i class="bi bi-droplet me-1"></i>Modificar Tipo de Sangre</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="IdExpedienteEditar" id="txtEditExpedienteId" />
                    <p class="text-muted small mb-2" id="txtEditSocioNombre"></p>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Nuevo Tipo de Sangre *</label>
                        <select asp-for="TipoSangreEditar" id="txtEditTipoSangre" class="form-select form-select-sm" required>
                            <option value="">-- Selecciona --</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-save me-1"></i>Actualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Nueva Condición en Catálogo -->
<div class="modal fade" id="modalNuevaCondicion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="NuevaCondicionCatalogo">
                <div class="modal-header bg-dark text-white py-3">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-square me-2"></i>Registrar Condición Médica en Catálogo</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nombre de la Condición *</label>
                        <input asp-for="NombreCondicionCatalogo" class="form-control form-control-sm" placeholder="Ej. Hipertensión arterial, Asma, Lesión meniscal" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tipo de Condición *</label>
                        <select asp-for="TipoCondicionCatalogo" class="form-select form-select-sm" required>
                            <option value="">-- Selecciona tipo --</option>
                            <option value="Padecimiento">Padecimiento</option>
                            <option value="Lesión">Lesión</option>
                            <option value="Alergia">Alergia</option>
                            <option value="Riesgo">Riesgo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Descripción / Recomendaciones</label>
                        <textarea asp-for="DescripcionCondicionCatalogo" class="form-control form-control-sm" rows="3" placeholder="Recomendaciones generales de entrenamiento y cuidados..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-check-lg me-1"></i>Guardar en Catálogo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function prepararEdicionSangre(btn) {
            var id = btn.getAttribute('data-id');
            var socio = btn.getAttribute('data-socio');
            var sangre = btn.getAttribute('data-sangre');

            document.getElementById('txtEditExpedienteId').value = id;
            document.getElementById('txtEditSocioNombre').textContent = 'Socio: ' + socio;
            document.getElementById('txtEditTipoSangre').value = sangre;
        }
    </script>
}
