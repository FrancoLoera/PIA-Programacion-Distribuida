@page
@model PIA_Gimnasio.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Módulo de Reportes Oficiales";
    var reporteActivo = Model.TipoReporte?.ToLower() ?? "socios";
}

<style>
    @@media print {
        .no-print, header, footer, .navbar, .btn, .card-header, form {
            display: none !important;
        }
        .container {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        table {
            font-size: 10pt !important;
        }
        .print-title {
            display: block !important;
        }
    }
    .print-title {
        display: none;
    }
</style>

<div class="print-title mb-4">
    <h3 class="fw-bold mb-1">PIA Gimnasio — Reporte Oficial</h3>
    <p class="text-muted small">Generado el: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    <hr />
</div>

<div class="row mb-4 align-items-center no-print">
    <div class="col-md-7">
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-file-earmark-bar-graph me-2"></i>Reportes Oficiales</h3>
        <p class="text-muted small mb-0">Consultas analíticas consolidadas de socios, asistencia, aforos, clases y empleados.</p>
    </div>
    <div class="col-md-5 text-md-end mt-2 mt-md-0">
        <button type="button" class="btn btn-outline-dark btn-sm me-1" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Imprimir / Exportar PDF
        </button>
        <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Inicio
        </a>
    </div>
</div>

<!-- Selector de Tipo de Reporte (Pills) -->
<div class="card bg-white shadow-sm border-0 mb-4 no-print">
    <div class="card-body p-2">
        <ul class="nav nav-pills nav-fill gap-1">
            <li class="nav-item">
                <a class="nav-link @(reporteActivo == "socios" ? "active bg-dark" : "text-dark") small fw-semibold"
                   asp-page="/Reportes/Index" asp-route-TipoReporte="Socios">
                    <i class="bi bi-people me-1"></i>1. Socios y Membresías
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(reporteActivo == "acceso" ? "active bg-dark" : "text-dark") small fw-semibold"
                   asp-page="/Reportes/Index" asp-route-TipoReporte="Acceso">
                    <i class="bi bi-shield-check me-1"></i>2. Accesos y Torniquetes
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(reporteActivo == "clases" ? "active bg-dark" : "text-dark") small fw-semibold"
                   asp-page="/Reportes/Index" asp-route-TipoReporte="Clases">
                    <i class="bi bi-calendar3 me-1"></i>3. Clases y Asistencia
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(reporteActivo == "rutinas" ? "active bg-dark" : "text-dark") small fw-semibold"
                   asp-page="/Reportes/Index" asp-route-TipoReporte="Rutinas">
                    <i class="bi bi-person-walking me-1"></i>4. Planes de Rutina
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(reporteActivo == "empleados" ? "active bg-dark" : "text-dark") small fw-semibold"
                   asp-page="/Reportes/Index" asp-route-TipoReporte="Empleados">
                    <i class="bi bi-person-badge me-1"></i>5. Plantilla Personal
                </a>
            </li>
        </ul>
    </div>
</div>

<!-- Filtros Específicos según Reporte Seleccionado -->
<div class="card bg-white shadow-sm border-0 mb-4 no-print">
    <div class="card-header bg-light py-2">
        <span class="small fw-bold text-dark"><i class="bi bi-funnel me-1"></i>Parámetros de Filtrado</span>
    </div>
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="TipoReporte" value="@Model.TipoReporte" />

            @if (reporteActivo == "socios")
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Sucursal</label>
                    <select name="FiltroSucursal" class="form-select form-select-sm">
                        <option value="">-- Todas las sedes --</option>
                        @if (Model.Sucursales != null)
                        {
                            foreach (System.Data.DataRow s in Model.Sucursales.Rows)
                            {
                                var id = Convert.ToInt16(s["IdSucursal"]);
                                var sel = Model.FiltroSucursal == id ? "selected" : null;
                                <option value="@id" selected="@sel">@s["Nombre"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Plan de Membresía</label>
                    <select name="FiltroMembresia" class="form-select form-select-sm">
                        <option value="">-- Todos los planes --</option>
                        @if (Model.Membresias != null)
                        {
                            foreach (System.Data.DataRow m in Model.Membresias.Rows)
                            {
                                var id = Convert.ToByte(m["IdMembresia"]);
                                var sel = Model.FiltroMembresia == id ? "selected" : null;
                                <option value="@id" selected="@sel">@m["Nombre"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Estatus del Socio</label>
                    <select name="FiltroEstatusCliente" class="form-select form-select-sm">
                        <option value="">-- Todos --</option>
                        @{ var selEC1 = Model.FiltroEstatusCliente == 1 ? "selected" : null; }
                        <option value="1" selected="@selEC1">Activo</option>
                        @{ var selEC2 = Model.FiltroEstatusCliente == 2 ? "selected" : null; }
                        <option value="2" selected="@selEC2">Inactivo</option>
                        @{ var selEC3 = Model.FiltroEstatusCliente == 3 ? "selected" : null; }
                        <option value="3" selected="@selEC3">Suspendido</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Estatus Suscripción</label>
                    <select name="FiltroEstatusSuscripcion" class="form-select form-select-sm">
                        <option value="">-- Todos --</option>
                        @{ var selES2 = Model.FiltroEstatusSuscripcion == 2 ? "selected" : null; }
                        <option value="2" selected="@selES2">Activa</option>
                        @{ var selES3 = Model.FiltroEstatusSuscripcion == 3 ? "selected" : null; }
                        <option value="3" selected="@selES3">Vencida</option>
                        @{ var selES4 = Model.FiltroEstatusSuscripcion == 4 ? "selected" : null; }
                        <option value="4" selected="@selES4">Cancelada</option>
                    </select>
                </div>
            }
            else if (reporteActivo == "acceso")
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Socio</label>
                    <select name="FiltroCliente" class="form-select form-select-sm">
                        <option value="">-- Todos los socios --</option>
                        @if (Model.Socios != null)
                        {
                            foreach (System.Data.DataRow c in Model.Socios.Rows)
                            {
                                var id = Convert.ToInt32(c["IdCliente"]);
                                var sel = Model.FiltroCliente == id ? "selected" : null;
                                <option value="@id" selected="@sel">[@c["Folio"]] @c["Nombres"] @c["PrimerApellido"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Sucursal</label>
                    <select name="FiltroSucursal" class="form-select form-select-sm">
                        <option value="">-- Todas las sucursales --</option>
                        @if (Model.Sucursales != null)
                        {
                            foreach (System.Data.DataRow s in Model.Sucursales.Rows)
                            {
                                var id = Convert.ToInt16(s["IdSucursal"]);
                                var sel = Model.FiltroSucursal == id ? "selected" : null;
                                <option value="@id" selected="@sel">@s["Nombre"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Fecha Inicio</label>
                    <input type="date" name="FechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Fecha Fin</label>
                    <input type="date" name="FechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
            }
            else if (reporteActivo == "clases")
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Sucursal</label>
                    <select name="FiltroSucursal" class="form-select form-select-sm">
                        <option value="">-- Todas las sedes --</option>
                        @if (Model.Sucursales != null)
                        {
                            foreach (System.Data.DataRow s in Model.Sucursales.Rows)
                            {
                                var id = Convert.ToInt16(s["IdSucursal"]);
                                var sel = Model.FiltroSucursal == id ? "selected" : null;
                                <option value="@id" selected="@sel">@s["Nombre"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Instructor</label>
                    <select name="FiltroEmpleado" class="form-select form-select-sm">
                        <option value="">-- Todos los instructores --</option>
                        @if (Model.Empleados != null)
                        {
                            foreach (System.Data.DataRow emp in Model.Empleados.Rows)
                            {
                                var id = Convert.ToInt32(emp["IdEmpleado"]);
                                var sel = Model.FiltroEmpleado == id ? "selected" : null;
                                <option value="@id" selected="@sel">@emp["Nombres"] @emp["PrimerApellido"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Fecha de Clase</label>
                    <input type="date" name="FiltroFechaClase" value="@Model.FiltroFechaClase?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Filtro Asistencia</label>
                    <select name="FiltroEstatusReserva" class="form-select form-select-sm">
                        <option value="">-- Todas las reservas --</option>
                        @{ var selRv1 = Model.FiltroEstatusReserva == 1 ? "selected" : null; }
                        <option value="1" selected="@selRv1">Confirmadas</option>
                        @{ var selRv3 = Model.FiltroEstatusReserva == 3 ? "selected" : null; }
                        <option value="3" selected="@selRv3">Asistieron</option>
                        @{ var selRv4 = Model.FiltroEstatusReserva == 4 ? "selected" : null; }
                        <option value="4" selected="@selRv4">No asistieron</option>
                    </select>
                </div>
            }
            else if (reporteActivo == "rutinas")
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Socio</label>
                    <select name="FiltroCliente" class="form-select form-select-sm">
                        <option value="">-- Todos los socios --</option>
                        @if (Model.Socios != null)
                        {
                            foreach (System.Data.DataRow c in Model.Socios.Rows)
                            {
                                var id = Convert.ToInt32(c["IdCliente"]);
                                var sel = Model.FiltroCliente == id ? "selected" : null;
                                <option value="@id" selected="@sel">[@c["Folio"]] @c["Nombres"] @c["PrimerApellido"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Entrenador</label>
                    <select name="FiltroEmpleado" class="form-select form-select-sm">
                        <option value="">-- Todos los entrenadores --</option>
                        @if (Model.Empleados != null)
                        {
                            foreach (System.Data.DataRow emp in Model.Empleados.Rows)
                            {
                                var id = Convert.ToInt32(emp["IdEmpleado"]);
                                var sel = Model.FiltroEmpleado == id ? "selected" : null;
                                <option value="@id" selected="@sel">@emp["Nombres"] @emp["PrimerApellido"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Grupo Muscular</label>
                    <select name="FiltroGrupoMuscular" class="form-select form-select-sm">
                        <option value="">-- Todos --</option>
                        @foreach (var gm in Model.GruposMusculares)
                        {
                            var sel = Model.FiltroGrupoMuscular == gm.IdGrupoMuscular ? "selected" : null;
                            <option value="@gm.IdGrupoMuscular" selected="@sel">@gm.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Dificultad</label>
                    <select name="FiltroDificultad" class="form-select form-select-sm">
                        <option value="">-- Todas --</option>
                        @foreach (var d in Model.Dificultades)
                        {
                            var sel = Model.FiltroDificultad == d.IdDificultad ? "selected" : null;
                            <option value="@d.IdDificultad" selected="@sel">@d.Nombre</option>
                        }
                    </select>
                </div>
            }
            else if (reporteActivo == "empleados")
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Sucursal</label>
                    <select name="FiltroSucursal" class="form-select form-select-sm">
                        <option value="">-- Todas las sedes --</option>
                        @if (Model.Sucursales != null)
                        {
                            foreach (System.Data.DataRow s in Model.Sucursales.Rows)
                            {
                                var id = Convert.ToInt16(s["IdSucursal"]);
                                var sel = Model.FiltroSucursal == id ? "selected" : null;
                                <option value="@id" selected="@sel">@s["Nombre"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Puesto</label>
                    <select name="FiltroPuesto" class="form-select form-select-sm">
                        <option value="">-- Todos los puestos --</option>
                        @if (Model.Puestos != null)
                        {
                            foreach (System.Data.DataRow p in Model.Puestos.Rows)
                            {
                                var id = Convert.ToByte(p["IdPuesto"]);
                                var sel = Model.FiltroPuesto == id ? "selected" : null;
                                <option value="@id" selected="@sel">@p["Nombre"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Especialidad</label>
                    <select name="FiltroEspecialidad" class="form-select form-select-sm">
                        <option value="">-- Todas las especialidades --</option>
                        @if (Model.Especialidades != null)
                        {
                            foreach (System.Data.DataRow esp in Model.Especialidades.Rows)
                            {
                                var id = Convert.ToByte(esp["IdEspecialidad"]);
                                var sel = Model.FiltroEspecialidad == id ? "selected" : null;
                                <option value="@id" selected="@sel">@esp["Nombre"]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Contratación Desde</label>
                    <input type="date" name="FechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Contratación Hasta</label>
                    <input type="date" name="FechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
            }

            <div class="col-12 text-end mt-3">
                <button type="submit" class="btn btn-dark btn-sm me-1">
                    <i class="bi bi-funnel-fill me-1"></i>Aplicar Filtros
                </button>
                <a asp-page="/Reportes/Index" asp-route-TipoReporte="@Model.TipoReporte" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-circle me-1"></i>Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Resultados del Reporte -->
<div class="card bg-white shadow-sm border-0">
    <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0 fw-semibold">
            <i class="bi bi-table me-2"></i>Resultados (@Model.DatosReporte.Rows.Count registros encontrados)
        </h6>
        <span class="small text-white-50">Reporte: @Model.TipoReporte</span>
    </div>
    <div class="card-body p-0">
        @if (Model.DatosReporte.Rows.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>
                No se encontraron registros que coincidan con los filtros aplicados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                @if (reporteActivo == "socios")
                {
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Folio</th>
                                <th>Nombre del Socio</th>
                                <th>Sucursal</th>
                                <th>Membresía</th>
                                <th>Estatus Suscripción</th>
                                <th>Vigencia</th>
                                <th class="text-center">Tipo Sangre</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow r in Model.DatosReporte.Rows)
                            {
                                var estado = r["EstadoCalculado"]?.ToString();
                                var badgeClass = estado == "Activa" ? "bg-dark text-white" : (estado == "Vencida" ? "bg-warning text-dark" : "bg-light text-dark border");
                                <tr>
                                    <td class="fw-bold small">@r["Folio"]</td>
                                    <td>
                                        <div class="fw-semibold">@r["NombreCompleto"]</div>
                                        <span class="small text-muted">@r["Correo"] | @r["Telefono"]</span>
                                    </td>
                                    <td class="small">@r["Sucursal"]</td>
                                    <td><span class="badge bg-light text-dark border">@r["Membresia"]</span></td>
                                    <td><span class="badge @badgeClass">@estado</span></td>
                                    <td class="small text-muted">
                                        @(r["VencimientoSuscripcion"] != DBNull.Value ? Convert.ToDateTime(r["VencimientoSuscripcion"]).ToString("dd/MM/yyyy") : "-")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-dark">@(r["TipoSangre"] != DBNull.Value ? r["TipoSangre"] : "-")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (reporteActivo == "acceso")
                {
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Socio</th>
                                <th>Sucursal</th>
                                <th>Entrada</th>
                                <th>Salida</th>
                                <th class="text-center">Tiempo (Min)</th>
                                <th>Estatus</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow r in Model.DatosReporte.Rows)
                            {
                                var salida = r["FechaHoraSalida"] != DBNull.Value ? Convert.ToDateTime(r["FechaHoraSalida"]).ToString("dd/MM/yyyy HH:mm") : "En curso";
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@r["Socio"]</div>
                                        <span class="small text-muted">Folio: @r["Folio"]</span>
                                    </td>
                                    <td class="small">@r["Sucursal"]</td>
                                    <td class="small">@Convert.ToDateTime(r["FechaHoraEntrada"]).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="small">@salida</td>
                                    <td class="text-center fw-semibold">@r["MinutosEnInstalaciones"] min</td>
                                    <td>
                                        <span class="badge @(r["Estatus"]?.ToString() == "En curso" ? "bg-warning text-dark" : "bg-dark text-white")">
                                            @r["Estatus"]
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (reporteActivo == "clases")
                {
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Clase</th>
                                <th>Sucursal / Salón</th>
                                <th>Fecha y Horario</th>
                                <th>Instructor</th>
                                <th class="text-center">Cupo</th>
                                <th class="text-center">Reservas</th>
                                <th class="text-center">Asistieron</th>
                                <th class="text-center">Inasistencias</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow r in Model.DatosReporte.Rows)
                            {
                                <tr>
                                    <td class="fw-semibold">@r["Clase"]</td>
                                    <td class="small">@r["Sucursal"] <span class="text-muted">(@r["Salon"])</span></td>
                                    <td class="small">
                                        @Convert.ToDateTime(r["Fecha"]).ToString("dd/MM/yyyy")
                                        <div class="text-muted small">@r["HoraInicio"] - @r["HoraFin"]</div>
                                    </td>
                                    <td class="small">@r["Entrenador"]</td>
                                    <td class="text-center fw-semibold">@r["CupoMaximo"]</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@r["TotalReservas"]</span></td>
                                    <td class="text-center"><span class="badge bg-dark text-white">@r["SociosAsistieron"]</span></td>
                                    <td class="text-center"><span class="badge bg-secondary text-white">@r["SociosNoAsistieron"]</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (reporteActivo == "rutinas")
                {
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Socio</th>
                                <th>Rutina</th>
                                <th>Entrenador</th>
                                <th>Día</th>
                                <th>Ejercicio</th>
                                <th>Músculo</th>
                                <th class="text-center">Series x Reps</th>
                                <th class="text-center">Descanso</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow r in Model.DatosReporte.Rows)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@r["Socio"]</div>
                                        <span class="small text-muted">Folio: @r["Folio"]</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold small">@r["NombreRutina"]</div>
                                        <span class="badge bg-light text-dark border small">@r["EstatusRutina"]</span>
                                    </td>
                                    <td class="small text-muted">@r["Entrenador"]</td>
                                    <td><span class="badge bg-dark text-white">@r["NombreDia"]</span></td>
                                    <td class="fw-semibold small">@r["Ejercicio"]</td>
                                    <td class="small text-muted">@r["GrupoMuscular"]</td>
                                    <td class="text-center small">@r["Series"] x @r["Repeticiones"]</td>
                                    <td class="text-center small text-muted">@r["SegundosDescanso"] s</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (reporteActivo == "empleados")
                {
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Nombre Completo</th>
                                <th>Puesto</th>
                                <th>Sucursal</th>
                                <th>Especialidades</th>
                                <th>Fecha Contratación</th>
                                <th>Contacto</th>
                                <th>Estatus</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow r in Model.DatosReporte.Rows)
                            {
                                <tr>
                                    <td class="fw-semibold">@r["NombreCompleto"]</td>
                                    <td><span class="badge bg-light text-dark border">@r["Puesto"]</span></td>
                                    <td class="small">@r["Sucursal"]</td>
                                    <td class="small text-muted">@r["Especialidades"]</td>
                                    <td class="small">@Convert.ToDateTime(r["FechaContratacion"]).ToString("dd/MM/yyyy")</td>
                                    <td class="small">
                                        <div>@r["Correo"]</div>
                                        <span class="text-muted">@r["Telefono"]</span>
                                    </td>
                                    <td><span class="badge bg-dark text-white">@r["Estatus"]</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>
</div>
