@page
@model PIA_Gimnasio.Pages.Reservas.IndexModel
@{
    ViewData["Title"] = "Reservas y Asistencia";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-card-checklist me-2"></i>Reservas y Asistencia</h3>
        <p class="text-muted small mb-0">Inscripción de socios a clases grupales y registro de asistencia.</p>
    </div>
    <div class="col-md-5 text-md-end mt-2 mt-md-0">
        <a asp-page="/Clases/Index" class="btn btn-outline-secondary btn-sm me-1">
            <i class="bi bi-calendar3 me-1"></i>Cartelera de Clases
        </a>
        <a asp-page="/Index" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Inicio
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    var alertClass = Model.TipoMensaje == "success" ? "alert-dark" : "alert-warning";
    var iconClass = Model.TipoMensaje == "success" ? "bi-check-circle" : "bi-exclamation-triangle";
    <div class="alert @alertClass alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi @iconClass me-2"></i>@Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="row g-4">
    @if (Model.PuedeInscribir)
    {
        <!-- Formulario Inscribir Socio -->
        <div class="col-lg-4">
            <div class="card bg-white shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white py-3">
                    <h6 class="card-title mb-0 fw-semibold">
                        <i class="bi bi-plus-circle me-2"></i>Inscribir Socio a Clase
                    </h6>
                </div>
                <div class="card-body p-3">
                    <form method="post" asp-page-handler="Inscribir">
                        <div class="mb-3">
                            <label asp-for="IdClaseReserva" class="form-label small fw-semibold">Clase Programada *</label>
                            <select asp-for="IdClaseReserva" class="form-select form-select-sm" required>
                                <option value="">-- Selecciona clase --</option>
                                @if (Model.Clases != null)
                                {
                                    foreach (System.Data.DataRow c in Model.Clases.Rows)
                                    {
                                        var idClase = c["IdClase"]?.ToString();
                                        var nomClase = c["Nombre"]?.ToString();
                                        var f = Convert.ToDateTime(c["Fecha"]).ToString("dd/MM");
                                        var hIni = ((TimeSpan)c["HoraInicio"]).ToString(@"hh\:mm");
                                        var sal = c["Salon"]?.ToString();
                                        var texto = $"{nomClase} ({f} {hIni} - {sal})";
                                        <option value="@idClase">@texto</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdClienteReserva" class="form-label small fw-semibold">Socio *</label>
                            <select asp-for="IdClienteReserva" class="form-select form-select-sm" required>
                                <option value="">-- Selecciona socio --</option>
                                @if (Model.Socios != null)
                                {
                                    foreach (System.Data.DataRow s in Model.Socios.Rows)
                                    {
                                        var idCli = s["IdCliente"]?.ToString();
                                        var folio = s["Folio"]?.ToString();
                                        var nomCli = $"{folio} &bull; {s["PrimerApellido"]} {s["Nombres"]}";
                                        <option value="@idCli">@folio - @s["PrimerApellido"] @s["Nombres"]</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-dark btn-sm py-2">
                                <i class="bi bi-check-circle me-1"></i>Confirmar Reserva
                            </button>
                        </div>

                        <div class="form-text small text-muted mt-3">
                            <i class="bi bi-info-circle me-1"></i>El sistema valida que la membresía del socio incluya clases, que no supere el límite semanal y que haya cupo disponible en el salón.
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Listado y Pase de Lista -->
    <div class="@(Model.PuedeInscribir ? "col-lg-8" : "col-12")">
        <!-- Filtros -->
        <div class="card bg-white shadow-sm border-0 mb-3">
            <div class="card-body p-3">
                <form method="get" class="row g-2">
                    <div class="col-md-6">
                        <select asp-for="FiltroClase" class="form-select form-select-sm">
                            <option value="">Todas las clases</option>
                            @if (Model.Clases != null)
                            {
                                foreach (System.Data.DataRow c in Model.Clases.Rows)
                                {
                                    var idC = c["IdClase"]?.ToString();
                                    var nC = c["Nombre"]?.ToString();
                                    var f = Convert.ToDateTime(c["Fecha"]).ToString("dd/MM");
                                    var h = ((TimeSpan)c["HoraInicio"]).ToString(@"hh\:mm");
                                    <option value="@idC">@nC (@f @h)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select asp-for="FiltroEstatus" class="form-select form-select-sm">
                            <option value="">Todos los estatus</option>
                            <option value="1">Confirmada</option>
                            <option value="3">Asistió</option>
                            <option value="4">No asistió</option>
                            <option value="2">Cancelada</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-dark btn-sm w-100">
                            <i class="bi bi-funnel me-1"></i>Filtrar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card bg-white shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width: 50px;">ID</th>
                            <th>Socio</th>
                            <th>Clase y Horario</th>
                            <th style="width: 110px;">Estatus</th>
                            <th class="text-end pe-3" style="width: 170px;">Pase de Lista</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Reservas == null || Model.Reservas.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                                    No se encontraron reservas registradas.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (System.Data.DataRow row in Model.Reservas.Rows)
                            {
                                var idRes = Convert.ToInt32(row["IdReserva"]);
                                var socio = row["Cliente"]?.ToString() ?? "";
                                var folio = row["Folio"]?.ToString() ?? "";
                                var clase = row["Clase"]?.ToString() ?? "";
                                var fClase = Convert.ToDateTime(row["Fecha"]).ToString("dd/MM/yyyy");
                                var hIni = ((TimeSpan)row["HoraInicio"]).ToString(@"hh\:mm");
                                var hFin = ((TimeSpan)row["HoraFin"]).ToString(@"hh\:mm");
                                var estatus = row["Estatus"]?.ToString() ?? "";
                                var idEstatus = Convert.ToByte(row["IdEstatus"]);

                                string badgeClass = idEstatus switch
                                {
                                    1 => "bg-dark text-white",         // Confirmada
                                    2 => "bg-secondary text-white",    // Cancelada
                                    3 => "bg-dark text-white border",  // Asistió
                                    4 => "bg-warning text-dark",       // No asistió
                                    _ => "bg-light text-dark border"
                                };

                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@idRes</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@socio</div>
                                        <small class="text-muted"><i class="bi bi-tag me-1"></i>@folio</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@clase</div>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@fClase (@hIni - @hFin)</small>
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass">@estatus</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            @if (idEstatus == 1) // Confirmada -> Pase de lista
                                            {
                                                <form method="post" asp-page-handler="Asistencia" asp-route-idReserva="@idRes" asp-route-resultado="3" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-dark" title="Marcar: Asistió">
                                                        <i class="bi bi-check2"></i>
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Asistencia" asp-route-idReserva="@idRes" asp-route-resultado="4" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-secondary" title="Marcar: No asistió">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Cancelar" asp-route-idReserva="@idRes" class="d-inline" onsubmit="return confirm('¿Cancelar esta reserva?');">
                                                    <button type="submit" class="btn btn-outline-danger" title="Cancelar reserva">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (User.IsInRole("Administrador") && (idEstatus == 3 || idEstatus == 4))
                                            {
                                                <!-- Administrador puede corregir asistencia -->
                                                <form method="post" asp-page-handler="Asistencia" asp-route-idReserva="@idRes" asp-route-resultado="@(idEstatus == 3 ? 4 : 3)" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-dark btn-sm" title="Corregir asistencia">
                                                        <i class="bi bi-arrow-repeat me-1"></i>Corregir
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">&mdash;</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
